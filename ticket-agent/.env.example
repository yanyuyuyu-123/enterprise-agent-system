# 应用
APP_NAME=ticket-agent
APP_ENV=dev

# 数据库：应用连接固定 UTC（不使用本地时区）
DATABASE_URL=postgresql+psycopg://ticket:ticket@localhost:15432/ticket

# Redis：缓存、Celery broker/backend、确认令牌
REDIS_URL=redis://localhost:16379/0

# JWT
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=120
REFRESH_TOKEN_DAYS=7

# 敏感字段加密（AES-256-GCM），值为 base64 编码的 32 字节密钥
# 生成：python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
LOG_ENC_KEY=

# 首个管理员密码，仅初始迁移使用，首次登录强制改密
BOOTSTRAP_ADMIN_PASSWORD=

# LLM
DEEPSEEK_API_KEY=

# Embedding（V2 知识库）：local=本地 bge-m3；dashscope=阿里云百炼
EMBEDDING_PROVIDER=local
# local 时的推理后端：onnx=量化 int8（常驻内存更小，推荐）；torch=sentence-transformers
EMBEDDING_BACKEND=onnx
# 本地模型目录（local 时必填），需包含 config.json、pytorch_model.bin 等完整文件
EMBEDDING_MODEL_PATH=
# onnx 后端目录，需包含 model_int8.onnx 与 tokenizer 文件；建议放在纯英文路径
EMBEDDING_ONNX_PATH=
# dashscope 时使用以下配置
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3
# 必须与 knowledge_chunks.embedding 的向量维度一致，默认 1024
EMBEDDING_DIM=1024

# 存储：local（V1）/ s3（后续）
STORAGE_BACKEND=local
STORAGE_ROOT=storage

# V3 本地语音：SenseVoice int8（含 model.int8.onnx、tokens.txt）+ Silero VAD
VOICE_ASR_MODEL_DIR=
VOICE_ASR_VAD_MODEL=
VOICE_ASR_THREADS=2
# 本地/外部 CosyVoice2 TTS 服务地址
COSYVOICE_BASE_URL=http://127.0.0.1:15000
COSYVOICE_SPEAKER=中文女
VOICE_TTS_TIMEOUT_SECONDS=60

# V3 音视频转写：ffmpeg 可执行文件绝对路径，留空时从 PATH 查找
FFMPEG_BIN=

# V3 声纹：CAM++ 模型路径（相对路径以 ticket-agent 为根）；留空则唤醒不做本人校验
VOICE_SV_MODEL=

# V3 OCR：优先使用本地 RapidOCR；未安装时才回退云 OCR REST
# 未配置云 OCR 且本地不可用时，图片标记 failed，扫描版 PDF 保持 need_ocr
ALIYUN_OCR_ENDPOINT=
